# Copia a .env.local (desarrollo) y configura en Vercel > Settings > Environment Variables.
# NUNCA subas valores reales al repositorio.

# --- SOLO SERVIDOR (jamás con prefijo NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Pública (opcional): URL final del sitio, para Open Graph / WhatsApp ---
NEXT_PUBLIC_SITE_URL=

# La apertura de la lista NO se controla con variables: se hace en Supabase
# (party_events.registration_open). Ver docs/DEPLOY.md.
